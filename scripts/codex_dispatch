#!/bin/zsh
# Dispatch a brief to Codex and capture the WHOLE reply, or fail loudly.
#
# Three failures in one session came from the same shape: the capture failed and the capture was
# then reported as the result. Twice a `| tail -N` truncated a reply mid-write and the truncated
# text was read as Codex's answer -- once losing findings 1-6 of an eight-finding review, once
# reading a header-only file as "came back empty" and announcing a re-dispatch. Once a newline
# broke an `&&` chain so an unverified commit went through.
#
# So: never pipe a dispatch through `tail`. Capture everything, then PROVE the reply is complete
# before anyone reads it. A reply that is only the "turn: model=..." header is a capture that lost
# the race with the turn, not an empty answer -- this polls `codex-run read` for it instead of
# reporting the empty file.
#
#   scripts/codex_dispatch <thread-id> <brief-path> [--cwd DIR] [--effort E]
#
# Exits non-zero and says why if the reply cannot be shown to be complete.
set -u
CR=/Users/vinylfreak89/Documents/codex-app/bin/codex-run
thread=$1; brief=$2; shift 2
out=$(mktemp -t codexreply)
"$CR" task "$thread" "$brief" "$@" > "$out" 2>&1
lines=$(grep -vc '^turn: model=' "$out" 2>/dev/null || echo 0)
if [ "$lines" -lt 1 ]; then
  echo "CAPTURE INCOMPLETE: the reply file holds only the turn header." >&2
  echo "The turn may still have been writing. Recovering from the thread itself:" >&2
  "$CR" read "$thread" 2>&1 | tail -120
  echo >&2
  echo "^^ recovered from 'codex-run read'. Do NOT report the empty file as Codex's answer." >&2
  exit 3
fi
cat "$out"
echo
echo "--- capture verified: $(wc -l < "$out") lines, $(wc -c < "$out") bytes, saved at $out"
